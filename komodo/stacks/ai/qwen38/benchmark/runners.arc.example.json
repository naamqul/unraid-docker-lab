{
  "schema_version": 1,
  "template": "arc-262k-mtp1",
  "defaults": {
    "context": 262144,
    "api_key_env": "OPENAI_API_KEY",
    "request_timeout_seconds": 21600,
    "min_free_gib": 8,
    "require_memory_check": true,
    "require_exact_context": true,
    "require_mtp_stats": true,
    "max_consecutive_errors": 1,
    "verify_tls": true
  },
  "runners": [
    {
      "name": "upstream-cpu",
      "backend": "upstream-cpu",
      "base_url": "http://127.0.0.1:9293/v1",
      "native_base_url": "http://127.0.0.1:9293/upstream/qwen38-upstream-262k-mtp1",
      "model": "qwen38-upstream-262k-mtp1",
      "backend_evidence_file": "/tmp/qwen38-benchmark/qwen38-upstream.startup.log",
      "required_backend_regex": "(?i)CPU",
      "forbidden_backend_regex": "(?i)(CUDA|SYCL|OPENVINO|offloaded [1-9][0-9]* layers)"
    },
    {
      "name": "ik-cpu",
      "backend": "ik-cpu",
      "base_url": "http://127.0.0.1:9294/v1",
      "native_base_url": "http://127.0.0.1:9294/upstream/qwen38-ik-262k-mtp1",
      "model": "qwen38-ik-262k-mtp1",
      "backend_evidence_file": "/tmp/qwen38-benchmark/qwen38-ik.startup.log",
      "required_backend_regex": "(?i)CPU",
      "forbidden_backend_regex": "(?i)(CUDA|SYCL|OPENVINO|offloaded [1-9][0-9]* layers)"
    },
    {
      "name": "openvino-npu-feasibility",
      "backend": "openvino-npu",
      "base_url": "http://127.0.0.1:9295/v1",
      "native_base_url": "http://127.0.0.1:9295",
      "model": "qwen38-openvino-262k-vision",
      "require_mtp_stats": false,
      "comparison_note": "This deployed OpenVINO lane validates NPU execution but does not enable MTP; do not treat it as MTP parity.",
      "backend_evidence_file": "/tmp/qwen38-benchmark/qwen38-openvino-262k-vision.startup.log",
      "required_backend_regex": "(?is)OPENVINO.*NPU|NPU.*OPENVINO",
      "forbidden_backend_regex": "(?i)OPENVINO_DEVICE[=: ]+CPU",
      "require_backend_evidence": true,
      "require_activity": true,
      "activity_files": [
        "/sys/class/accel/accel0/device/npu_busy_time_us"
      ]
    }
  ]
}
